@article{Gigante2023b,
  title = {Reconstruction of the {{Temporal Correlation Network}} of {{All-Cause Mortality Fluctuation}} across {{Italian Regions}}: {{The Importance}} of {{Temperature}} and {{Among-Nodes Flux}}},
